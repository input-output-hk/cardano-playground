{config, lib, name, ...}: let
  inherit (builtins) stringLength substring;
  inherit (lib) toUpper;

  capitalize = s: toUpper (substring 0 1 s) + substring 1 (stringLength s - 1) s;

  groupCfg = config.cardano-parts.cluster.group;
  environmentName = groupCfg.meta.environmentName;
  groupName = groupCfg.groupName;
in {
  leiosAlloyConfig = ''
    prometheus.scrape "cardano_node_exporter" {
      targets = [{
          __address__ = "0.0.0.0:12798",
          // For compatibility with proto-devnet-throughput dashboard
          // job         = "cardano_node_metrics",
          instance    = "${name}",
          alias       = "${name}",
          process     = "${capitalize name}",
          environment = "${environmentName}",
          group       = "${groupName}",
      }]

      metrics_path = "/metrics"

      // For compatibility with proto-devnet-throughput dashboard
      job_name     = "cardano_node_metrics"

      forward_to = [prometheus.remote_write.integrations.receiver]
    }

    loki.process "leios_journal_router" {
      stage.match {
        selector = `{systemd_unit!~"cardano-node.service|cardano-tx-centrifuge.service"}`
        action   = "drop"
      }

      stage.match {
        selector = `{systemd_unit="cardano-node.service"}`
        stage.static_labels {
          values = {
            process = "cardano-node",
          }
        }
      }

      stage.match {
        selector = `{systemd_unit="cardano-tx-centrifuge.service"}`
        stage.static_labels {
          values = {
            process = "TxCentrifuge",
          }
        }
      }

      forward_to = [loki.process.extract_cardano_node_logs.receiver]
    }

    loki.process "extract_cardano_node_logs" {
      stage.json {
        expressions = {
          at     = "at",
          sev    = "sev",
          host   = "host",
          thread = "thread",
          ns     = "ns",
          data   = "data",
        }
        drop_malformed = true
      }

      stage.drop {
        source = "process"
        value = "Analyze"
      }

      stage.timestamp {
        source = "at"
        format = "RFC3339"
      }

      stage.labels {
        values = {
          level = "sev",
          host  = "host",
          sev   = "sev",
          ns    = "ns",
        }
      }

      stage.static_labels {
        values = {
          service = "cardano-node",
          type    = "cardano-node",
        }
      }

      stage.match {
        selector = `{process="TxCentrifuge"}`
        stage.static_labels {
          values = {
            service = "tx-centrifuge",
            type    = "tx-centrifuge",
          }
        }
      }

      // Normalize the 'data' object's key ordering. The upstream JSON
      // from journald is consistently ordered, but alloy itself loses
      // that ordering: stage.json above decodes 'data' into a Go
      // map[string]interface{} (Go maps carry no key order), and the
      // stage.output below re-marshals that map to a string without
      // sorting, producing different key orders run-to-run. Round-
      // tripping through Sprig's fromJson | toJson forces a final
      // re-marshal via Go's encoding/json, which sorts map keys
      // alphabetically and recursively, giving a deterministic line.
      // The hasPrefix guard skips the round-trip when 'data' isn't
      // object-shaped (strings, arrays, null) so we don't accidentally
      // rewrite those. Note: number precision is float64 after round-
      // trip — fine for the counters here, but be aware if a future
      // namespace emits integers > 2^53.
      stage.template {
        source = "data"
        template = `{{ if hasPrefix "{" .Value }}{{ .Value | fromJson | toJson }}{{ else }}{{ .Value }}{{ end }}`
      }

      stage.output {
        source = "data"
      }

      forward_to = [loki.write.default.receiver]
    }
  '';
}
