{
  namespace = "cardano";
  name = "cardano-node-generic";
  rule = [
    {
      # Leios is excluded here (see the leios-specific variant below): its chain
      # density is much lower/variable, so normal inter-block gaps reach ~10 min
      # and would false-fire this 7-minute trigger.
      alert = "cardano_node_blockheight_unchanged";
      expr = ''rate(cardano_node_metrics_blockNum_int{environment!~"leios"}[5m]) == 0'';
      for = "2m";
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: cardano-node blockheight unchanged for more than 7 minutes.";
        description = "{{$labels.instance}}: cardano-node blockheight unchanged for more than 7 minutes.";
      };
    }
    {
      # Leios-only block-stall alert with a substantially longer trigger. Leios
      # runs at reduced, bursty chain density (many 3rd-party pools wedged), so
      # normal gaps between blocks reach ~10 min (observed max ~587s). A ~20-minute
      # trigger sits above that normal gap while still catching a genuine node
      # wedge, which freezes for tens of minutes to hours (i.e. needs an operator
      # reseed). 10m rate window + 10m `for` => pages after ~20 min of no new block.
      alert = "cardano_node_blockheight_unchanged_leios";
      expr = ''rate(cardano_node_metrics_blockNum_int{environment=~"leios"}[10m]) == 0'';
      for = "10m";
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: cardano-node (leios) blockheight unchanged for more than 20 minutes.";
        description = "{{$labels.instance}}: cardano-node (leios) blockheight unchanged for more than 20 minutes.";
      };
    }
    {
      alert = "cardano_node_elevated_restarts";
      # The systemd expression can be used but only in systems with high sampling frequency, otherwise, the state change may not be detected.
      # Therefore the second expression is preferred although not yet available in the new tracing system:
      # expr = ''round(increase(node_systemd_unit_state{name=~"cardano-node(-[0-9]+)?.service", state="active"}[1h])) > 1'';
      expr = ''round(increase((time() - cardano_node_metrics_nodeStartTime_int < bool 300)[1h:1m])) > 1'';
      for = "5m";
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: cardano-node has experienced multiple restarts in the past hour.";
        description = "{{$labels.instance}}: cardano-node has restarted {{ printf \"%.0f\" $value }} times in the past hour.";
      };
    }
    {
      alert = "cardano_node_mempool_high";
      expr = ''cardano_node_metrics_txsInMempool_int{environment!~"leios"} > 200'';
      for = "10m";
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: cardano-node transactions in mempool have been elevated for more than 10 minutes.";
        description = "{{$labels.instance}}: cardano-node transactions in mempool have been greater than 200 for more than 10 minutes.";
      };
    }
    {
      alert = "cardano_node_mempool_soft_timeouts_detected";
      # Alert on any increase in soft timeouts over a 1-hour lookback window.
      expr = "increase(txsMempoolTimeoutSoft[1h]) > 4 or increase(cardano_node_metrics_txsMempoolTimeoutSoft_counter[1h]) > 4";
      for = "1m";
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: cardano-node mempool soft timeouts detected.";
        description = "{{$labels.instance}}: cardano-node mempool has rejected {{ printf \"%.0f\" $value }} transaction(s) due to soft timeout in the past hour.";
      };
    }
    {
      alert = "cardano_node_mempool_hard_timeouts_detected";
      # Alert on any increase in hard timeouts over a 1-hour lookback window.
      expr = "increase(txsMempoolTimeoutHard[1h]) > 4 or increase(cardano_node_metrics_txsMempoolTimeoutHard_counter[1h]) > 4";
      for = "1m";
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: cardano-node mempool hard timeouts detected.";
        description = "{{$labels.instance}}: cardano-node mempool has rejected {{ printf \"%.0f\" $value }} transaction(s) due to hard timeout in the past hour.";
      };
    }
    # Note: This alert will automatically disable after 6 hours (360 minutes) even if there are still no expected metrics available.
    {
      alert = "cardano_node_metric_missing";
      expr = "(sum_over_time((cardano_node_metrics_blockNum_int != bool 0)[360m:1m]) < bool 350) > 0 unless cardano_node_metrics_blockNum_int";
      for = "1m";
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: cardano-node blockheight metric has gone missing for more than 10 minutes.";
        description = "{{$labels.instance}}: cardano-node blockheight metric has gone missing for more than 10 minutes at a 1 minute resolution.";
      };
    }
  ];
}
