let
  stalledFor = "75m";

  wedgeWindow = "15m";
  wedgeFor = "5m";
  minHotPeers = "5";

  pingGoneFor = "10m";

  acceptStalledFor = "5m";
  minOverflowRate = "0.1";
  maxAcceptRate = "0.25";
in {
  namespace = "cardano";
  name = "leios-wedge";
  rule = [
    {
      alert = "leios_load_generation_stalled";
      expr = ''max by (environment) (cardano_node_metrics_txsInMempool_int{environment="leios"}) == 0'';
      for = stalledFor;
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.environment}}: no transactions in any mempool for ${stalledFor}.";
        description = "{{$labels.environment}}: fleet-wide mempool has been empty for ${stalledFor}, longer than the tx-centrifuge off window of about 65 min, so load generation is not resuming on schedule. Check tx-centrifuge for a KeepAlive crash loop, then check the relays for an inbound governor wedge.";
      };
    }
    {
      alert = "leios_relay_inbound_governor_wedged";
      expr = ''changes(cardano_node_metrics_inboundGovernor_hot_int{environment="leios", instance=~".*-rel-.*"}[${wedgeWindow}]) == 0 and cardano_node_metrics_inboundGovernor_hot_int{environment="leios", instance=~".*-rel-.*"} > ${minHotPeers}'';
      for = wedgeFor;
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: inbound governor has not promoted a peer in ${wedgeWindow}.";
        description = "{{$labels.instance}}: `inboundGovernor_hot` has held a constant value for ${wedgeWindow} while the connection manager keeps accepting connections, so the inbound governor event loop is blocked. New peers complete a handshake but are never promoted to warm or hot. Only a cardano-node restart has been seen to clear it, and the median window before the RuntimeMaxSec recycle closes it is about 7h. Capture the connection stuck in mux `Stopping` before restarting.";
      };
    }
    {
      alert = "leios_node_ping_sample_missing";
      expr = ''count by (instance) (cardano_node_metrics_blockNum_int{environment="leios"}) unless count by (instance) (cardano_node_metrics_custom_ping_latency_ms{environment="leios"})'';
      for = pingGoneFor;
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: no cardano-cli ping sample for ${pingGoneFor}.";
        description = "{{$labels.instance}}: the node is scraped and reporting blockNum but cardano-custom-metrics has published no ping sample for ${pingGoneFor}, so the local ping is failing or hanging. On a relay the usual cause is an inbound governor wedge, since the ping is an inbound connection that a blocked governor never promotes; check `leios_relay_inbound_governor_wedged` for the same host. Confirm on the host with `cardano-cli ping --count=1 --quiet --json --host=0.0.0.0 --port=3001 --magic=$TESTNET_MAGIC`, which returns in about 2s when healthy.";
      };
    }
    {
      alert = "leios_node_accept_queue_overflowing";
      expr = ''rate(node_netstat_TcpExt_ListenOverflows{instance=~"leios.*"}[10m]) > ${minOverflowRate} and rate(node_netstat_Tcp_PassiveOpens{instance=~"leios.*"}[10m]) < ${maxAcceptRate}'';
      for = acceptStalledFor;
      labels.severity = "page";
      annotations = {
        summary = "{{$labels.instance}}: kernel is dropping inbound connections, cardano-node has stopped accepting.";
        description = "{{$labels.instance}}: the TCP accept queue is overflowing at {{ printf \"%.2f\" $value }} connections/s, so cardano-node is no longer calling accept() on its listening sockets. The node keeps following the chain over its existing outbound connections and keeps logging, so it looks healthy from systemd, but it serves nothing inbound and its own metrics endpoint stops answering too. Confirm with `ss -lnt '( sport = :3001 or sport = :12798 )'`, where Recv-Q pinned at or above Send-Q is the accept queue standing full. Only a cardano-node restart has been seen to clear it.";
      };
    }
  ];
}
