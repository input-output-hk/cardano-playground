    {
      "type": "timeseries",
      "title": "Signer submissions per bar",
      "description": "Local submissions over the dmq-node socket, as accepted or by rejection reason. The signer falls back to the aggregator when dmq-node rejects.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance) (count_over_time({instance=~\"$instance\", systemd_unit=\"dmq-node.service\"} |= `\"ns\":\"Net.Local.SigSubmission.Server.TraceSubmitAccept\"` [$__interval]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{instance}} accepted",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance, reason) (count_over_time({instance=~\"$instance\", systemd_unit=\"dmq-node.service\"} |= `\"ns\":\"Net.Local.SigSubmission.Server.TraceSubmitFailure\"` | json reason=\"data.event.error\" | label_format reason=`{{ regexReplaceAll \" .*\" .reason \"\" }}` [$__interval]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{instance}} {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "showPoints": "never",
