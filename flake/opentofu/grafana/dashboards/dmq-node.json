        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Hot peers",
      "description": "Peers dmq-node exchanges signatures with now. Zero isolates the node.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (instance) (dmq_node_peerSelection_Hot_int{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Sigs accepted from peers",
      "description": "Signatures received from peers and added to the local mempool over the dashboard range.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (instance) (increase(dmq_node_txSubmission_txsAccepted_int{instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "refId": "A"
