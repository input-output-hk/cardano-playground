        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(up{job=\"integrations/dmq-node\"}, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"integrations/dmq-node\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "regex": "",
        "sort": 1
      }
    ]
