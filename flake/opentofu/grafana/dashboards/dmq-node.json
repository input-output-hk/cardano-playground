    {
      "type": "stat",
      "title": "Signer sigs accepted",
      "description": "Signatures the local mithril-signer submitted and dmq-node accepted over the dashboard range. Only block producers have a signer.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance) (count_over_time({instance=~\"$instance\", systemd_unit=\"dmq-node.service\"} |= `\"ns\":\"Net.Local.SigSubmission.Server.TraceSubmitAccept\"` [$__range]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
